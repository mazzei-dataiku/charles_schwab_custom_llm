/* This file is the descriptor for custom LLM gemini-flash */
{
  "meta" : {
    // label: name of the LLM as displayed, should be short
    "label": "Vertex AI Gemini Flash",

    // description: longer string to help end users understand what this LLM does.
    "description": "Google Vertex AI managed Gemini publisher model (generateContent REST API).",

    // icon: must be one of the FontAwesome 5.15.4 icons, complete list here at https://fontawesome.com/v5/docs/
    "icon": "fab fa-google"
  },

  /* params:
  DSS will generate a form from this list of requested parameters.
  Your component code can then access the value provided by users using the "name" field of each parameter.

  Available parameter types include:
  STRING, INT, DOUBLE, BOOLEAN, DATE, SELECT, TEXTAREA, PRESET and others.

  Warning: COLUMN_VALUE and COLUMN_VALUES are supported in Dataiku Apps, but not in plugins.

  For the full list and for more details, see the documentation: https://doc.dataiku.com/dss/latest/plugins/reference/params.html
  */
  "params": [
    {
      "name": "model_id",
      "label": "Model ID",
      "type": "STRING",
      "description": "Vertex publisher model ID (e.g. gemini-3.8-flash).",
      "mandatory": false,
      "defaultValue": "gemini-3.8-flash"
    },
    {
      "name": "max_output_tokens",
      "label": "Max output tokens",
      "type": "INT",
      "description": "Maximum number of tokens to generate.",
      "mandatory": false,
      "defaultValue": 1024
    },
    {
      "name": "temperature",
      "label": "Temperature",
      "type": "DOUBLE",
      "description": "Controls randomness of outputs.",
      "mandatory": false,
      "defaultValue": 0.2
    }
  ]
}
